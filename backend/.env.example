PORT=5000
# production: NODE_ENV=production also serves frontend/dist from this server (override with SERVE_FRONTEND)
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Serve frontend/dist from this server without NODE_ENV=production (e.g. local demo behind ngrok)
SERVE_FRONTEND=false
# Number of proxies in front of the server (1 behind ngrok or a host), so rate limits see real client IPs
TRUST_PROXY=0

# Local: mongodb://127.0.0.1:27017/deepfake-detector
# Atlas: mongodb+srv://<user>:<password>@<cluster>/deepfake-detector
MONGODB_URI=mongodb://127.0.0.1:27017/deepfake-detector

# Max upload size in MB
MAX_UPLOAD_MB=200
# Max uploads per client IP in a 10-minute window
UPLOADS_PER_10_MIN=30
# Keep the original upload on disk after scanning (false = delete, keep only hash + results)
KEEP_UPLOADS=false

# Optional explicit binary paths if ffmpeg/ffprobe are not on PATH
FFMPEG_PATH=
FFPROBE_PATH=

# Optional external ML inference service. When empty, the local ONNX models are used
# (download them once with `npm run models:download`); without those, a stub detector.
# Expected endpoints: POST {DETECTOR_URL}/detect/{video|image|audio} (multipart field "file")
# returning JSON { "score": 0..1, "segments": [{ "start": s, "end": s, "score": 0..1 }]? }
DETECTOR_URL=
DETECTOR_TIMEOUT_MS=60000
